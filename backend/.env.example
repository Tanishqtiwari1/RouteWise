# Copy to backend/.env for local development. Placeholder values only — never commit real secrets.
ROUTEWISE_ENVIRONMENT=development
# SQLite for local dev/tests; PostgreSQL in production:
# ROUTEWISE_DATABASE_URL=postgresql+psycopg://routewise:CHANGE_ME@localhost:5432/routewise
ROUTEWISE_DATABASE_URL=sqlite:///./data/routewise.db
ROUTEWISE_DATA_DIR=./data
# Comma-separated list of browser origins allowed to call the API directly.
ROUTEWISE_CORS_ORIGINS=http://localhost:5173
# Shared secret required (X-Admin-Token header) for closures, network imports and settings. Leave empty only for local dev.
ROUTEWISE_ADMIN_TOKEN=
# Identify your deployment to OpenStreetMap services (required by their usage policies).
ROUTEWISE_HTTP_USER_AGENT=RouteWise/1.0 (contact: ops@example.com)
ROUTEWISE_MAX_NETWORK_AREA_KM2=200
ROUTEWISE_MAX_SNAP_DISTANCE_M=1500
ROUTEWISE_UCS_MAX_EXPANSIONS=3000000
ROUTEWISE_UCS_TIME_LIMIT_S=20
ROUTEWISE_MULTI_STOP_MAX_STOPS=10
ROUTEWISE_MULTI_STOP_MAX_STATES=300000
ROUTEWISE_RATE_LIMIT_PER_MINUTE=30
ROUTEWISE_LOG_LEVEL=INFO
